{
  "version": 2,
  "routes": [
    {
      "src": "/beta",
      "dest": "/beta.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/chapter/.*",
      "dest": "/index.html"
    },
    {
      "src": "/dpp/.*",
      "dest": "/index.html"
    },
    {
      "src": "/practice/.*",
      "dest": "/practice.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}